set-globals, media_dir="$(test_dir)/../../medias/defaults"
meta,
    tool = "ges-launch-$(gst_api_version)",
    seek=true,
    handles-states=true,
    needs_preroll=true,
    ges = "uridecodepoolsrc=enabled,converter-type=gl,compositor-factory=glvideomixer",
    ges-options={
        "--track-types=video",
        "--video-caps=video/x-raw(ANY), format=(string)I420, width=(int)1080, height=(int)720, framerate=(fraction)30/1",
        --videosink, "$(videosink) name=videosink",
        -o, /tmp/test.mp4,
    }

set-vars,
    media_uri="file://$(media_dir)/matroska/timed_frames_video_only_1fps_with_qrcodes.mkv",
    media_uri1="file://$(media_dir)/matroska/numerated_frames_red_qrcodes.mkv"

foreach, subtimeline_primary_id=<"act0", "scene0", "beat0", "beat1">,
  actions = {
    [register-subtimeline-primary, primary-id="$(subtimeline_primary_id)"],
    [add-track, project-uri="gessubtimeline:$(subtimeline_primary_id)", track-type=video, caps="video/x-raw(ANY)", name="$(subtimeline_primary_id)_video_track"],
  }

# Create the 'beats' timeline, which could be a compared as 'a paragraph or two'
# for a book
add-clip, project-uri="gessubtimeline:beat0", name=beat0_clip0, asset-id="$(media_uri)", duration=5.0
add-clip, project-uri="gessubtimeline:beat0", name=beat0_clip1, asset-id="$(media_uri1)", start=5.0, duration=2.0

add-clip, project-uri="gessubtimeline:beat1", name=beat1_clip0, asset-id="$(media_uri)", duration=5.0
container-add-child, project-uri="gessubtimeline:beat1", container-name=beat1_clip0,
  asset-id="textoverlay text='First clip of the second beat' ! capsfilter caps=video/x-raw(ANY)", child-type=GESEffect
add-clip, project-uri="gessubtimeline:beat1", name=beat1_clip1, asset-id="$(media_uri1)", start=5.0, duration=2.0, inpoint=1.

container-add-child, project-uri="gessubtimeline:beat1", container-name=beat1_clip1,
  asset-id="textoverlay text='Second clip of the second beat' ! capsfilter caps=video/x-raw(ANY)", child-type=GESEffect

add-clip, project-uri="gessubtimeline:scene0", name=scene0_beat0, asset-id="gessubtimeline:beat0", start=0.0, inpoint=2.0, duration=5.0
add-clip, project-uri="gessubtimeline:scene0", name=scene0_beat1, asset-id="gessubtimeline:beat1", start=5.0

add-clip, project-uri="gessubtimeline:act0", name=acts_scene0, asset-id="gessubtimeline:scene0"

add-clip, name=act0, asset-id="gessubtimeline:act0"

play
