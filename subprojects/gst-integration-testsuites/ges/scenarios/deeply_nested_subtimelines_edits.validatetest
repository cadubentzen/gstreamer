set-globals, media_dir="$(test_dir)/../../medias/defaults"
meta,
    tool = "ges-launch-$(gst_api_version)",
    seek=true,
    handles-states=true,
    needs_preroll=true,
    ges-options={
        "--track-types=video",
        "--video-caps=video/x-raw, format=(string)I420, width=(int)1080, height=(int)720, framerate=(fraction)1/1",
        --videosink, "$(videosink) name=videosink",
    }

set-vars,
    media_uri="file://$(media_dir)/matroska/timed_frames_video_only_1fps_with_qrcodes.mkv"

foreach, subtimeline_primary_id=<"act0", "scene0", "beat0", "beat1">,
  actions = {
    [register-subtimeline-primary, primary-id="$(subtimeline_primary_id)"],
    [add-track, project-uri="gessubtimeline:$(subtimeline_primary_id)", track-type=video, caps="video/x-raw"],
  }

# Create the 'beats' timeline, which could be a compared as 'a paragraph or two'
# for a book
add-clip, project-uri="gessubtimeline:beat0", name=beat0_clip0, asset-id="$(media_uri)", duration=5.0
add-clip, project-uri="gessubtimeline:beat0", name=beat0_clip1, asset-id="$(media_uri)", start=5.0, inpoint=5.0, duration=5.0

add-clip, project-uri="gessubtimeline:beat1", name=beat1_clip, asset-id="$(media_uri)", duration=5.0
add-clip, project-uri="gessubtimeline:beat1", name=beat1_clip1, asset-id="$(media_uri)", start=5.0

add-clip, project-uri="gessubtimeline:scene0", name=scene0_beat0, asset-id="gessubtimeline:beat0"
add-clip, project-uri="gessubtimeline:scene0", name=scene0_beat1, asset-id="gessubtimeline:beat1"

add-clip, project-uri="gessubtimeline:act0", name=acts_scene0, asset-id="gessubtimeline:beat0"

# Now create the main timeline, which uses the 'act0' subtimeline
add-clip, name=act0, asset-id="gessubtimeline:beat0"

play
