set-globals, media_dir="$(test_dir)/../../medias/defaults"
meta,
    tool = "ges-launch-$(gst_api_version)",
    handles-states=true,
    needs_preroll=true,
    ges-options= {
        --track-types, video,
        --video-caps, "video/x-raw, format=(string)I420, width=(int)1080, height=(int)720, framerate=(fraction)1/1, chroma-site=(string)jpeg, colorimetry=(string)bt601",
        --videosink, "$(videosink) name=videosink",
    }

set-vars,
    nested_timeline_uri="file://$(logsdir)/ges/scenarios/$(test_name)/nested_timeline.xges"

# Create nested timeline with full video (frames 0-19)
add-clip, name=inner-clip, asset-id="file://$(media_dir)/matroska/timed_frames_video_only_1fps.mkv", layer-priority=0, type=GESUriClip
serialize-project, uri="$(nested_timeline_uri)"
remove-clip, name=inner-clip

# Add nested timeline clip at start=0, inpoint=0, duration=5s (shows frames 0-4)
add-clip, name=nested-clip, asset-id="$(nested_timeline_uri)", layer-priority=0, type=GESUriClip, start=0.0, inpoint=0.0, duration=5.0

commit;
pause;

# Now edit the clip: trim start by 3s (moves start to 3, inpoint to 3, duration to 2)
# After this edit: clip shows frames 3, 4 starting at position 3s
edit-container, container-name=(string)nested-clip, edit-mode=(string)edit_trim, position=(double)3.0, new-layer-priority=(int)-1, edge=(string)edge_start;

commit;

# Play to verify the edit took effect - if preload values weren't updated,
# we might see wrong frames or errors
play;
stop;
