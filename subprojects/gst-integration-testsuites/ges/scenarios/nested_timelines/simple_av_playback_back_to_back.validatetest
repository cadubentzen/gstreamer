set-globals,
  media_dir="$(test_dir)/../../../medias/defaults",
  audio_caps="audio/x-raw, format=(string)S16LE, rate=(int)48000, channels=(int)1, layout=(string)interleaved",
  video_caps="video/x-raw, format=(string)I420, width=(int)1080, height=(int)720, framerate=(fraction)1/1"

meta,
    tool = "ges-launch-$(gst_api_version)",
    seek=true,
    handles-states=true,
    needs_preroll=true,
    ges = "uridecodepoolsrc=enabled,compositor-factory=compositor,converter-type=software",
    ges-options={
        "--track-types=audio+video",
        "--video-caps=$(video_caps)",
        "--audio-caps=$(audio_caps)",
        "--videosink=capsfilter caps=\"$(video_caps)\" ! videoconvert ! $(videosink) name=videosink",
        "--audiosink=audiobuffersplit output-buffer-duration=1/10 ! capsfilter caps=\"$(audio_caps)\" ! audioconvert ! audioresample ! $(audiosink) name=audiosink",
    },
    configs = {
        "$(validateflow), pad=audiosink:sink, record-buffers=true, ignored-fields=\"stream-start={stream-id,group-id,stream}, segment={position,}, buffer={dur,}\", ignored-event-types={gap}",
        "$(validateflow), pad=videosink:sink, buffers-checksum=sha256, ignored-fields=\"stream-start={stream-id,group-id,stream}, segment={position,}, buffer={meta,}\", ignored-event-types={gap}",
    }


set-vars,
    media_uri0="file://$(media_dir)/mp4/blue_timed_frames_av_1fps.mp4",
    media_uri1="file://$(media_dir)/mp4/red_timed_frames_av_1fps.mp4",
    media_uri2="file://$(media_dir)/mp4/green_timed_frames_av_1fps.mp4"

# Create a subtimeline with 3 clips back-to-back using different
# audio+video sources (blue/red/blue timed video frames)
# so clip transitions are clearly distinguishable
register-subtimeline-primary, primary-id="sub0"
add-track, project-uri="gessubtimeline:sub0", track-type=video, caps="video/x-raw", name="sub0_video_track"
add-track, project-uri="gessubtimeline:sub0", track-type=audio, caps="audio/x-raw", name="sub0_audio_track"

add-clip, project-uri="gessubtimeline:sub0", name=clip0, asset-id="$(media_uri0)", duration=2.0
add-clip, project-uri="gessubtimeline:sub0", name=clip1, asset-id="$(media_uri1)", start=2.0, duration=2.0
add-clip, project-uri="gessubtimeline:sub0", name=clip2, asset-id="$(media_uri2)", start=4.0, duration=2.0

# Add the subtimeline twice back to back on the main timeline
add-clip, name=sub0_clip1, asset-id="gessubtimeline:sub0", duration=6.0
add-clip, name=sub0_clip2, asset-id="gessubtimeline:sub0", start=6.0, duration=6.0

# Timeline structure:
#
# MAIN TIMELINE
#   0s                  6s                  12s
#   |-------------------|-------------------|
#   [sub0_clip1]        [sub0_clip2]
#     |                   |
#     v                   v
# SUBTIMELINE: sub0    SUBTIMELINE: sub0 (same content, played again)
#   0s        2s        4s        6s
#   |---------|---------|---------|
#   [clip0]   [clip1]   [clip2]
#   blue      red       blue
#   (a+v)     (a+v)     (a+v)
#   2s        2s        2s
#
# The same nested timeline is played twice back to back.
# Audio and video must continue playing across all transitions,
# including the transition between the two subtimeline instances.

pause

wait, duration=0.1
play
