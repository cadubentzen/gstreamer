# Test 3-level nesting with rate effect on the outermost clip
#
# Exercises seek translation cascading through 3 NLE composition levels.
# The rate adjustment happens at the outermost level, then the adjusted
# seek flows through middle and inner compositions.
#
# Structure:
#   - L1 (inner): media clip with inpoint=2, duration=15
#   - L2 (middle): nested timeline referencing L1, inpoint=0, duration=15
#   - L3 (outer): nested timeline referencing L2, inpoint=3, videorate rate=2.0
#
# P is the seek position in the main timeline. Seek translation at each level:
#
#   L3 NLE: media_time = P - 0 + 3 = P + 3
#   L3 rate (inpoint=3): offset = (P+3) - 3 = P, adj = P*2 -> start = 3 + P*2
#   L2 NLE: media_time = (3+P*2) - 0 + 0 = 3 + P*2  (inpoint=0, no effect)
#   L1 NLE: media_time = (3+P*2) - 0 + 2 = 5 + P*2   (no effect)
#   -> final frame = 5 + P*2
#
# Without rate effects, cumulative inpoints would give 3+0+2 = 5. The rate on
# L3 only affects the P-dependent term (doubling it to P*2). At P=0 the rate
# offset is 0, so the base frame stays at 5.
#
#   P=0 -> frame 5, P=1 -> frame 7, P=2 -> frame 9

set-globals, media_dir="$(test_dir)/../../../medias/defaults"
meta, seek=true, handles-states=true,
    tool = "ges-launch-$(gst_api_version)",
    ges = "uridecodepoolsrc=enabled",
    args = {
        --video-caps, "video/x-raw(ANY), format=(string)I420, width=(int)1080, height=(int)720, framerate=(fraction)1/1",
        --videosink, "$(videosink) name=videosink",
    }

set-vars,
    media_uri="file://$(media_dir)/matroska/timed_frames_video_only_1fps_with_qrcodes.mkv"

# L1: inner subtimeline with media clip
register-subtimeline-primary, primary-id="inner"
add-track, project-uri="gessubtimeline:inner", track-type=video, caps="video/x-raw(ANY)"
add-clip, project-uri="gessubtimeline:inner", name=inner_clip, asset-id="$(media_uri)", layer-priority=0, type=GESUriClip, inpoint=2.0, duration=15.0

# L2: middle subtimeline referencing inner
register-subtimeline-primary, primary-id="middle"
add-track, project-uri="gessubtimeline:middle", track-type=video, caps="video/x-raw(ANY)"
add-clip, project-uri="gessubtimeline:middle", name=middle_clip, asset-id="gessubtimeline:inner", layer-priority=0, type=GESUriClip, inpoint=0.0, duration=15.0

# L3: outer clip referencing middle with inpoint=3 and rate=2.0 effect
add-clip, name=outer_clip, asset-id="gessubtimeline:middle", layer-priority=0, type=GESUriClip, inpoint=3.0, duration=10.0
container-add-child, container-name=outer_clip, asset-id="videorate rate=2.0 name=rate-effect", child-type=GESEffect

commit;
pause;

# P=0: frame = 2 * 0 + 5 = 5
seek, flags=accurate+flush, start=0.0
check-last-frame-qrcode, sinkpad-caps="video/x-raw", expected-json-fields=[expected, TIMESTAMP=(gint64)5000000000]

# P=1: frame = 2 * 1 + 5 = 7
seek, flags=accurate+flush, start=1.0
check-last-frame-qrcode, sinkpad-caps="video/x-raw", expected-json-fields=[expected, TIMESTAMP=(gint64)7000000000]

# P=2: frame = 2 * 2 + 5 = 9
seek, flags=accurate+flush, start=2.0
check-last-frame-qrcode, sinkpad-caps="video/x-raw", expected-json-fields=[expected, TIMESTAMP=(gint64)9000000000]

# Clean up
unregister-subtimeline-primary, primary-id="middle"
unregister-subtimeline-primary, primary-id="inner"

stop;
