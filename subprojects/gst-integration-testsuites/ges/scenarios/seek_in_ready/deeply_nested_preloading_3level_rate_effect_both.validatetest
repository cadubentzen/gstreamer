# Test 3-level nesting with compound rate effects (inner + outer)
#
# Inner rate=2.0 x outer rate=2.0 = effective 4x frame progression.
# Cascading seek translations must compose correctly: outer adjusts first,
# then the adjusted seek enters the inner composition where the inner
# clip's rate adjusts again.
#
# Structure:
#   - L1 (inner): media clip with inpoint=1, videorate rate=2.0, duration=15
#   - L2 (middle): nested timeline referencing L1, inpoint=0, duration=15
#   - L3 (outer): nested timeline referencing L2, inpoint=1, videorate rate=2.0
#
# P is the seek position in the main timeline. Seek translation at each level:
#
#   L3 NLE: media_time = P - 0 + 1 = P + 1
#   L3 rate (inpoint=1): offset = (P+1) - 1 = P, adj = P*2 -> start = 1 + P*2
#   L2 NLE: media_time = (1+P*2) - 0 + 0 = 1 + P*2  (inpoint=0, no effect)
#   L1 NLE: media_time = (1+P*2) - 0 + 1 = 2 + P*2
#   L1 rate (inpoint=1): offset = (2+P*2) - 1 = 1+P*2, adj = (1+P*2)*2 = 2+P*4
#     -> final = 1 + 2 + P*4 = 3 + P*4
#
# Without rate effects, cumulative inpoints would give 1+0+1 = 2. The extra 1
# comes from L1's rate doubling the offset that L3's inpoint contributes past
# L1's inpoint (offset=1 at P=0 becomes 2 after rate adjustment).
#
#   P=0 -> frame 3, P=1 -> frame 7, P=2 -> frame 11, P=3 -> frame 15

set-globals, media_dir="$(test_dir)/../../../medias/defaults"
meta, seek=true, handles-states=true,
    tool = "ges-launch-$(gst_api_version)",
    ges = "uridecodepoolsrc=enabled",
    args = {
        --track-types, video,
        --video-caps, "video/x-raw(ANY), format=(string)I420, width=(int)1080, height=(int)720, framerate=(fraction)1/1",
        --videosink, "$(videosink) name=videosink",
    }

set-vars,
    media_uri="file://$(media_dir)/matroska/timed_frames_video_only_1fps_with_qrcodes.mkv"

# L1: inner subtimeline with media clip and rate=2.0
register-subtimeline-primary, primary-id="inner"
add-track, project-uri="gessubtimeline:inner", track-type=video, caps="video/x-raw(ANY)"
add-clip, project-uri="gessubtimeline:inner", name=inner_clip, asset-id="$(media_uri)", layer-priority=0, type=GESUriClip, inpoint=1.0, duration=15.0
container-add-child, project-uri="gessubtimeline:inner", container-name=inner_clip, asset-id="videorate rate=2.0 name=inner-rate-effect", child-type=GESEffect

# L2: middle subtimeline referencing inner
register-subtimeline-primary, primary-id="middle"
add-track, project-uri="gessubtimeline:middle", track-type=video, caps="video/x-raw(ANY)"
add-clip, project-uri="gessubtimeline:middle", name=middle_clip, asset-id="gessubtimeline:inner", layer-priority=0, type=GESUriClip, inpoint=0.0, duration=15.0

# L3: outer clip referencing middle with inpoint=1 and rate=2.0 effect
add-clip, name=outer_clip, asset-id="gessubtimeline:middle", layer-priority=0, type=GESUriClip, inpoint=1.0, duration=10.0
container-add-child, container-name=outer_clip, asset-id="videorate rate=2.0 name=outer-rate-effect", child-type=GESEffect

commit;
pause;

# P=0: frame = 3 + 0 * 4 = 3
seek, flags=accurate+flush, start=0.0
check-last-frame-qrcode, sinkpad-caps="video/x-raw", expected-json-fields=[expected, TIMESTAMP=(gint64)3000000000]

# P=1: frame = 3 + 1 * 4 = 7
seek, flags=accurate+flush, start=1.0
check-last-frame-qrcode, sinkpad-caps="video/x-raw", expected-json-fields=[expected, TIMESTAMP=(gint64)7000000000]

# P=2: frame = 3 + 2 * 4 = 11
seek, flags=accurate+flush, start=2.0
check-last-frame-qrcode, sinkpad-caps="video/x-raw", expected-json-fields=[expected, TIMESTAMP=(gint64)11000000000]

# P=3: frame = 3 + 3 * 4 = 15
seek, flags=accurate+flush, start=3.0
check-last-frame-qrcode, sinkpad-caps="video/x-raw", expected-json-fields=[expected, TIMESTAMP=(gint64)15000000000]

# Clean up
unregister-subtimeline-primary, primary-id="middle"
unregister-subtimeline-primary, primary-id="inner"

stop;
