# Test nested timeline preloading verifies single seek per source
#
# This test verifies that uridecodepoolsrc receives only ONE seek event
# when handling nested timelines with cascading inpoints.
#
# Structure:
#   - Inner: media clip with inpoint=2
#   - Outer: nested timeline with inpoint=3
#   - Total inpoint = 5
#
# The source should receive a single seek to position 5, not multiple seeks.

set-globals, media_dir="$(test_dir)/../../../medias/defaults"
meta,
    seek=true,
    handles-states=true,
    tool="ges-launch-$(gst_api_version)",
    ges="uridecodepoolsrc=enabled",
    monitor-all-pipelines=true,
    args={
        --track-types, video, --video-caps,
        "video/x-raw(ANY), format=(string)I420, width=(int)1080, height=(int)720, framerate=(fraction)1/1", --videosink,
        "$(videosink) name=videosink sync=false",
    },
    configs={
        # Monitor the uridecodepoolsrc src pad - should only see ONE seek event
        "$(validateflow), pad=\"[0-9a-f]+_timed_frames_video_only_1fps_with_qrcodes.mkv_[0-9]+-vsrc[0-9]+-uridecodepoolsrc:src$\", record-buffers=false, logged-event-types={}, ignored-fields=\"stream-start={stream-id,group-id,stream},segment=position,seek=nle-seek-reason\", logged-upstream-event-types={seek}",
    }

set-vars,
    media_uri="file://$(media_dir)/matroska/timed_frames_video_only_1fps_with_qrcodes.mkv",
    nested_timeline_uri="file://$(logsdir)/ges/scenarios/$(test_name)/nested.xges"

# Create the inner timeline: media clip with inpoint=2
add-clip, name=inner_clip, asset-id="$(media_uri)", layer-priority=0, type=GESUriClip, inpoint=2.0, duration=10.0
serialize-project, uri="$(nested_timeline_uri)"
remove-clip, name=inner_clip

# Add the nested timeline with inpoint=3
# Total seek should be to position 5 (2+3)
add-clip,
    name=nested_clip,
    asset-id="$(nested_timeline_uri)",
    layer-priority=0,
    type=GESUriClip,
    inpoint=3.0,
    duration=5.0

commit;
pause;

# Verify first frame is at TIMESTAMP 5 seconds (5000000000 ns)
# Note: No explicit seek needed - preroll already seeks to position 0
# The source should receive a single seek to position 5 (inner inpoint 2 + outer inpoint 3)
check-last-frame-qrcode, sinkpad-caps="video/x-raw", expected-json-fields=[expected, TIMESTAMP=(gint64)5000000000]

stop;
