# Test seek-in-ready with videorate rate=2.0 and non-zero clip start
#
# Verifies that seek-in-ready works correctly when a time effect is present
# and the clip starts at a non-zero timeline position. With start=3, rate=2.0
# and inpoint=2, P = seek_pos - start:
#   - seek to 4: P=1, media_time = 2 + 1*2 = 4
#   - seek to 6: P=3, media_time = 2 + 3*2 = 8
#   - seek to 8: P=5, media_time = 2 + 5*2 = 12

set-globals, media_dir="$(test_dir)/../../../medias/defaults"
meta, seek=true, handles-states=true,
    tool = "ges-launch-$(gst_api_version)",
    ges = "uridecodepoolsrc=enabled",
    args = {
        --track-types, video,
        --video-caps, "video/x-raw(ANY), format=(string)I420, width=(int)1080, height=(int)720, framerate=(fraction)1/1",
        --videosink, "$(videosink) name=videosink",
    },
    configs = {
        "$(validateflow), pad=rate-effect:src, ignored-event-types={tag,stream-start,caps,stream-group-done,flush-start,flush-stop,eos}, logged-fields=\"segment={start,stop}\"",
    }

add-clip, name=clip, asset-id="file://$(media_dir)/matroska/timed_frames_video_only_1fps_with_qrcodes.mkv", layer-priority=0, type=GESUriClip, start=3.0, inpoint=2.0, duration=10.0
container-add-child, container-name=clip, asset-id="videorate rate=2.0 name=rate-effect", child-type=GESEffect

commit;
pause;

checkpoint, text="seek to position 4s (P=1)";
seek, flags=accurate+flush, start=4.0
check-last-frame-qrcode, sinkpad-caps="video/x-raw", expected-json-fields=[expected, TIMESTAMP=(gint64)4000000000]

checkpoint, text="seek to position 6s (P=3)";
seek, flags=accurate+flush, start=6.0
check-last-frame-qrcode, sinkpad-caps="video/x-raw", expected-json-fields=[expected, TIMESTAMP=(gint64)8000000000]

checkpoint, text="seek to position 8s (P=5)";
seek, flags=accurate+flush, start=8.0
check-last-frame-qrcode, sinkpad-caps="video/x-raw", expected-json-fields=[expected, TIMESTAMP=(gint64)12000000000]

stop;
