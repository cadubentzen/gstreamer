# Test seek-in-ready with videorate rate=0.5 and non-zero clip start
#
# Completes the non-nested matrix (x2, x0_5, x2_start all exist).
#
# Structure:
#   - Single clip with start=3, inpoint=2, videorate rate=0.5, duration=10
#
# S is the seek position (S >= start=3). Seek translation:
#
#   NLE: media_time = S - 3 + 2 = S - 1
#   Rate (inpoint=2): offset = (S-1) - 2 = S-3, adj = (S-3)*0.5
#     -> final = 2 + (S-3)*0.5
#
#   seek to 3 (S-3=0): frame = 2 + 0 = 2
#   seek to 5 (S-3=2): frame = 2 + 1 = 3
#   seek to 7 (S-3=4): frame = 2 + 2 = 4
#   seek to 11 (S-3=8): frame = 2 + 4 = 6

set-globals, media_dir="$(test_dir)/../../medias/defaults"
meta, seek=true, handles-states=true,
    tool = "ges-launch-$(gst_api_version)",
    ges = "uridecodepoolsrc=enabled",
    args = {
        --track-types, video,
        --video-caps, "video/x-raw(ANY), format=(string)I420, width=(int)1080, height=(int)720, framerate=(fraction)1/1",
        --videosink, "$(videosink) name=videosink",
    },
    configs = {
        "$(validateflow), pad=rate-effect:src, ignored-event-types={tag,stream-start,caps,stream-group-done,flush-start,flush-stop,eos}, logged-fields=\"segment={start,stop}\"",
    }

add-clip, name=clip, asset-id="file://$(media_dir)/matroska/timed_frames_video_only_1fps_with_qrcodes.mkv", layer-priority=0, type=GESUriClip, start=3.0, inpoint=2.0, duration=10.0
container-add-child, container-name=clip, asset-id="videorate rate=0.5 name=rate-effect", child-type=GESEffect

commit;
pause;

checkpoint, text="seek to position 3s (P=0)";
seek, flags=accurate+flush, start=3.0
check-last-frame-qrcode, sinkpad-caps="video/x-raw", expected-json-fields=[expected, TIMESTAMP=(gint64)2000000000]

checkpoint, text="seek to position 5s (P=2)";
seek, flags=accurate+flush, start=5.0
check-last-frame-qrcode, sinkpad-caps="video/x-raw", expected-json-fields=[expected, TIMESTAMP=(gint64)3000000000]

checkpoint, text="seek to position 7s (P=4)";
seek, flags=accurate+flush, start=7.0
check-last-frame-qrcode, sinkpad-caps="video/x-raw", expected-json-fields=[expected, TIMESTAMP=(gint64)4000000000]

checkpoint, text="seek to position 11s (P=8)";
seek, flags=accurate+flush, start=11.0
check-last-frame-qrcode, sinkpad-caps="video/x-raw", expected-json-fields=[expected, TIMESTAMP=(gint64)6000000000]

stop;
