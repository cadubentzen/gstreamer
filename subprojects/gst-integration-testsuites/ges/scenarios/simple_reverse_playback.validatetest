set-globals, media_file="$(test_dir)/../../medias/defaults/matroska/red_timed_frames_video_only_1fps.mkv"
meta,
    tool = "ges-launch-$(gst_api_version)",
    handles-states = true,
    args = {
        --track-types, video,
        --video-caps, "video/x-raw(ANY),width=1080,height=720,framerate=1/1",
        --videosink, "$(videosink) name=videosink",
    },
    configs = {
        "$(validateflow), pad=videosink:sink, buffers-checksum=true, ignored-fields=\"stream-start={stream-id,group-id,stream}\"",
    }

add-clip, name=clip, asset-id="$(media_file)", layer-priority=0, type=GESUriClip, duration=20.0, inpoint=0.0
add-clip, name=clip, asset-id="$(media_file)", layer-priority=0, type=GESUriClip, duration=20.0, inpoint=0.0, start=20.0

play
crank-clock

seek, start=0.0, stop=25.0, flags=accurate+flush, rate=-1.0
crank-clock, expected-time=0.0

foreach, n=[0, 25],
  actions={
    [crank-clock, expected-elapsed-time=1.0],
  }
