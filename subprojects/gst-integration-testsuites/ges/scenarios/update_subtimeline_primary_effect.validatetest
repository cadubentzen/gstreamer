meta,
    tool = "ges-launch-$(gst_api_version)",
    seek = true,
    handles-states = true,
    ges = "uridecodepoolsrc=enabled",
    args = {
        --track-types, video,
        --video-caps, "video/x-raw(ANY), format=(string)I420, width=(int)1240, height=(int)720, framerate=(fraction)1/1",
        --videosink, "$(videosink) name=videosink",
    }

# remove-feature, name=queue
set-vars, media_uri="file://$(test_dir)/../../medias/defaults/matroska/timed_frames_video_only_1fps.mkv"

# Setup a primary timeline with a video track and clip
register-subtimeline-primary, primary-id="test-primary"
add-track, project-uri="gessubtimeline:test-primary", track-type=video, caps="video/x-raw(ANY)"
add-clip, project-uri="gessubtimeline:test-primary", name="primary-clip", layer-priority=0, asset-id="testbin://video,pattern=blue,caps=[video/x-raw,width=1240,height=720]", type=GESUriClip, start=0, duration=3.0, inpoint=5.0

# Use that primary timeline as a clip in the main timeline
add-clip, name="subtimeline-clip", layer-priority=0, asset-id="gessubtimeline:test-primary", type=GESUriClip, start=0, duration=3.0

commit
pause

container-add-child, project-uri="gessubtimeline:test-primary", container-name="primary-clip",
  asset-id="qroverlay x=50 y=10 data=GREAT_QRCODE name=qroverlay", child-type=GESEffect, child-name="qroverlay"
commit
check-last-frame-qrcode, sinkpad-caps="video/x-raw", expected-data="GREAT_QRCODE"

container-remove-child, project-uri="gessubtimeline:test-primary", container-name="primary-clip", child-name="qroverlay"
commit
check-last-frame-qrcode, sinkpad-caps="video/x-raw", expected-data={}

stop
