set-globals, media_file="$(test_dir)/../../medias/defaults/matroska/"
meta,
    tool = "ges-launch-$(gst_api_version)",
    ges = "uridecodepoolsrc=enabled",
    handles-states=true,
    needs_preroll=true,
    monitor-all-pipelines = true,
    args = {
        # The media file should play from 11. to 12.
        "+clip", "$(media_file)/red_timed_frames_video_only_1fps.mkv", "start=1.0", "i=5.0", "d=2.0",
        "+clip", "$(media_file)/timed_frames_video_only_1fps.mkv", "i=1.0", "d=5.0", "layer=1",
        "--track-types=video",
        "--videosink=$(videosink) name=videosink",
    },
    configs = {
        "$(validateflow), pad=\"^........._timed_frames_video_only_1fps.mkv_1-vsrc0-uridecodepoolsrc:src$\", record-buffers=true, ignored-fields=\"stream-start={stream-id,group-id,stream},segment=position,buffer={meta}\", logged-upstream-event-types={seek}, caps-properties={height,width,framerate}",
    }

wait-project-loaded
play


