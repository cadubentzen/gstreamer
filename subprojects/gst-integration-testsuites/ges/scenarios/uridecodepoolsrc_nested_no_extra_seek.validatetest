set-globals, media_file="$(test_dir)/../../medias/defaults/matroska/timed_frames_video_only_1fps.mkv"
meta,
    tool = "ges-launch-$(gst_api_version)",
    ges = "uridecodepoolsrc=enabled",
    handles-states=true,
    needs_preroll=true,
    monitor-all-pipelines = true,
    args = {
        # The media file should play from 11. to 12.
        "+clip", "ges:+track video +clip $(media_file) d=10.0 i=10.0", "i=1.0", "d=2.0",
          "+effect",
            "timeoverlay", "set-valignment", "center",
        "--track-types=video",
        "--videosink=$(videosink) name=videosink sync=false",
    },
    configs = {
        "$(validateflow), pad=videosink:sink, record-buffers=true, ignored-fields=\"stream-start={stream-id,group-id,stream},segment=position\"",

        "$(validateflow), pad=\"gessmartmixer0-compositor:src\", ignored-fields=\"stream-start={stream-id,group-id,stream},segment=position\", logged-upstream-event-types={seek}",

        # Monitor the uridecodepoolsrc src pad for unexpected seeks
        "$(validateflow), pad=\"^........._timed_frames_video_only_1fps.mkv_1-vsrc0-uridecodepoolsrc:src$\", record-buffers=true, ignored-fields=\"stream-start={stream-id,group-id,stream},segment=position\", logged-upstream-event-types={seek}",

        "$(validateflow), pad=timed_frames_video_only_1fps.mkv_1-vsrc1:src, record-buffers=true, logged-event-types={}, ignored-fields=\"stream-start={stream-id,group-id,stream},segment=position\", logged-upstream-event-types={seek}",
    }

wait-project-loaded
play

