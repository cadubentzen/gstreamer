set-globals, media_dir="$(test_dir)/../../medias/defaults"

meta,
    tool = "ges-launch-$(gst_api_version)",
    args = {
        --track-types, video,
        --video-caps, "video/x-raw,width=320,height=240,framerate=25/1,format=I420",
        --videosink, osxvideosink,
        --ignore-eos,
    },
    ges = "uridecodepoolsrc=enabled",
    tested-elements = { "uridecodepoolsrc", },
    ignore-invalid-positions = true,
    handles-states = true,
    ignore-eos = true

# Create multiple clips to trigger pipeline pool behavior
add-clip, name=c0, asset-id="file://$(media_dir)/mp4/mp3_h264.0.mp4", layer-priority=0, type=GESUriClip, start=0, duration=5.0
add-clip, name=c1, asset-id="file://$(media_dir)/ogg/vorbis_theora.0.ogg", layer-priority=0, type=GESUriClip, start=5.0, duration=5.0
add-clip, name=c2, asset-id="file://$(media_dir)/matroska/timed_frames_video_only_1fps.mkv", layer-priority=0, type=GESUriClip, start=10.0, duration=5.0
add-clip, name=c3, asset-id="file://$(media_dir)/mp4/mp3_h264.1.mp4", layer-priority=0, type=GESUriClip, start=15.0, duration=5.0
add-clip, name=c4, asset-id="file://$(media_dir)/ogg/vorbis_theora.1.ogg", layer-priority=0, type=GESUriClip, start=20.0, duration=5.0
add-clip, name=c5, asset-id="file://$(media_dir)/webm/vorbis_vp8.0.webm", layer-priority=0, type=GESUriClip, start=25.0, duration=5.0

commit
pause

seek, start=0.0, stop=30.0, flags=accurate+flush, rate=1.0
seek, start=5.0, stop=15.0, flags=accurate+flush, rate=1.0
seek, start=15.0, stop=25.0, flags=accurate+flush, rate=1.0
seek, start=2.0, stop=8.0, flags=accurate+flush, rate=1.0
seek, start=20.0, stop=28.0, flags=accurate+flush, rate=1.0

# Jump around to really exercise the pipeline pool
seek, start=12.0, stop=18.0, flags=accurate+flush, rate=1.0
seek, start=1.0, stop=6.0, flags=accurate+flush, rate=1.0
seek, start=22.0, stop=29.0, flags=accurate+flush, rate=1.0

# Check pipeline counts to verify no leaks
check-uridecodepool-pipelines

play

set-state, state=ready, playback_time=23.0

wait, duration=1.5

# Final pipeline count check - should be clean after setting to null
check-uridecodepool-pipelines, expected-prepared=0

stop
