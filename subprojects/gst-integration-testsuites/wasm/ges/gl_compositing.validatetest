meta,
    handles-states=true,
    tool = "ges-validate-wasm-$(gst_api_version)",
    ges = "converter-type=gl, compositor-factory=glvideomixer",
    args = {
        "--videosink glimagesink",
    }

# === Blue section (0-15s) ===

# Blue background
add-clip, name=bg-blue, asset-id="width=1920, height=1080", pattern=blue, layer-priority=2, type=GESTestClip, duration=15.0

# Circular pattern, drifts right to left
add-clip, name=circular, asset-id="width=1920, height=1080", pattern=circular, layer-priority=1, type=GESTestClip, duration=15.0
set-child-properties, element-name=circular, posx=960, posy=200, width=720, height=720, alpha=0.7

set-control-source, element-name=circular, property-name=posx, binding-type=direct-absolute, source-type=interpolation, interpolation-mode=linear
add-keyframe, element-name=circular, property-name=posx, timestamp=0.0, value=1100.0
add-keyframe, element-name=circular, property-name=posx, timestamp=7.5, value=100.0
add-keyframe, element-name=circular, property-name=posx, timestamp=15.0, value=1100.0

set-control-source, element-name=circular, property-name=alpha, binding-type=direct-absolute, source-type=interpolation, interpolation-mode=linear
add-keyframe, element-name=circular, property-name=alpha, timestamp=0.0, value=0.0
add-keyframe, element-name=circular, property-name=alpha, timestamp=2.0, value=0.7
add-keyframe, element-name=circular, property-name=alpha, timestamp=13.0, value=0.7
add-keyframe, element-name=circular, property-name=alpha, timestamp=15.0, value=0.0

# Moving ball PiP, bounces corner to corner
add-clip, name=ball, asset-id="width=1920, height=1080", pattern=ball, layer-priority=0, type=GESTestClip, duration=15.0
set-child-properties, element-name=ball, posx=40, posy=40, width=480, height=270

set-control-source, element-name=ball, property-name=posx, binding-type=direct-absolute, source-type=interpolation, interpolation-mode=linear
add-keyframe, element-name=ball, property-name=posx, timestamp=0.0, value=40.0
add-keyframe, element-name=ball, property-name=posx, timestamp=3.75, value=1400.0
add-keyframe, element-name=ball, property-name=posx, timestamp=7.5, value=40.0
add-keyframe, element-name=ball, property-name=posx, timestamp=11.25, value=1400.0
add-keyframe, element-name=ball, property-name=posx, timestamp=15.0, value=40.0

set-control-source, element-name=ball, property-name=posy, binding-type=direct-absolute, source-type=interpolation, interpolation-mode=linear
add-keyframe, element-name=ball, property-name=posy, timestamp=0.0, value=40.0
add-keyframe, element-name=ball, property-name=posy, timestamp=5.0, value=770.0
add-keyframe, element-name=ball, property-name=posy, timestamp=10.0, value=40.0
add-keyframe, element-name=ball, property-name=posy, timestamp=15.0, value=770.0

# === Green section (15-30s) ===

# Green background
add-clip, name=bg-green, asset-id="width=1920, height=1080", pattern=green, layer-priority=2, type=GESTestClip, start=15.0, duration=15.0

# SMPTE bars overlay, swings left to right
add-clip, name=smpte, asset-id="width=1920, height=1080", pattern=smpte, layer-priority=1, type=GESTestClip, start=15.0, duration=15.0
set-child-properties, element-name=smpte, posx=100, posy=100, width=800, height=450, alpha=0.8

set-control-source, element-name=smpte, property-name=posx, binding-type=direct-absolute, source-type=interpolation, interpolation-mode=linear
add-keyframe, element-name=smpte, property-name=posx, timestamp=0.0, value=100.0
add-keyframe, element-name=smpte, property-name=posx, timestamp=7.5, value=1020.0
add-keyframe, element-name=smpte, property-name=posx, timestamp=15.0, value=100.0

set-control-source, element-name=smpte, property-name=posy, binding-type=direct-absolute, source-type=interpolation, interpolation-mode=linear
add-keyframe, element-name=smpte, property-name=posy, timestamp=0.0, value=100.0
add-keyframe, element-name=smpte, property-name=posy, timestamp=5.0, value=530.0
add-keyframe, element-name=smpte, property-name=posy, timestamp=10.0, value=100.0
add-keyframe, element-name=smpte, property-name=posy, timestamp=15.0, value=530.0

# Pinwheel PiP, orbits bottom area
add-clip, name=pinwheel, asset-id="width=1920, height=1080", pattern=pinwheel, layer-priority=0, type=GESTestClip, start=15.0, duration=15.0
set-child-properties, element-name=pinwheel, posx=700, posy=700, width=400, height=400

set-control-source, element-name=pinwheel, property-name=posx, binding-type=direct-absolute, source-type=interpolation, interpolation-mode=linear
add-keyframe, element-name=pinwheel, property-name=posx, timestamp=0.0, value=100.0
add-keyframe, element-name=pinwheel, property-name=posx, timestamp=5.0, value=1420.0
add-keyframe, element-name=pinwheel, property-name=posx, timestamp=10.0, value=760.0
add-keyframe, element-name=pinwheel, property-name=posx, timestamp=15.0, value=100.0

set-control-source, element-name=pinwheel, property-name=posy, binding-type=direct-absolute, source-type=interpolation, interpolation-mode=linear
add-keyframe, element-name=pinwheel, property-name=posy, timestamp=0.0, value=580.0
add-keyframe, element-name=pinwheel, property-name=posy, timestamp=3.75, value=100.0
add-keyframe, element-name=pinwheel, property-name=posy, timestamp=7.5, value=580.0
add-keyframe, element-name=pinwheel, property-name=posy, timestamp=11.25, value=100.0
add-keyframe, element-name=pinwheel, property-name=posy, timestamp=15.0, value=580.0

set-control-source, element-name=pinwheel, property-name=alpha, binding-type=direct-absolute, source-type=interpolation, interpolation-mode=linear
add-keyframe, element-name=pinwheel, property-name=alpha, timestamp=0.0, value=0.0
add-keyframe, element-name=pinwheel, property-name=alpha, timestamp=2.0, value=0.9
add-keyframe, element-name=pinwheel, property-name=alpha, timestamp=13.0, value=0.9
add-keyframe, element-name=pinwheel, property-name=alpha, timestamp=15.0, value=0.0

play
