meta,
    handles-states=true,
    args = {
        "--track-types video --videosink glimagesink +test-clip smpte d=5.0 +effect gleffects_glow +test-clip blue d=5.0 inpoint=0 start=2000000000 +transition crossfade d=3000000000",
    }

# GES GL compositing test (browser only — requires WebGL context):
#  - Two video clips (SMPTE + blue) with a 3s crossfade transition
#  - GL glow effect on the first clip
#  - Compositing via GES smart mixer → glvideomixer
#  - Rendered to glimagesink (WebGL)
#
# Timeline layout:
#   0s ──── smpte + glow ──────── 5s
#                2s ──── blue ──────── 7s
#                2s ── crossfade ── 5s

set-state, state=playing
wait, duration=6.0
stop
