meta,
    handles-states=true,
    tool = "ges-validate-wasm-$(gst_api_version)",
    ges = "converter-type=gl, compositor-factory=glvideomixer",
    args = {

        "--videosink glimagesink",
    }

add-clip, name=clip, asset-id="blue", layer-priority=0, type=GESTestClip, duration=5.0
add-clip, name=clip1, asset-id="red", layer-priority=0, type=GESTestClip, duration=5.0

play
